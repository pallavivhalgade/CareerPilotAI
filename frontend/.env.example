# Optional: use a separate API origin for a deployed frontend.
# Without this variable, requests use /api on the frontend's origin.
# Vite proxies /api to the backend during local development and preview.
# VITE_API_URL=https://your-api.example.com

# For Docker or a backend on another local address:
# VITE_API_PROXY_TARGET=http://backend:8000

# Hosted account API: server-only variables in Vercel, never VITE_* variables.
# DATABASE_URL is provided by the Neon integration.
# SECRET_KEY must be a unique random value with at least 32 characters.
